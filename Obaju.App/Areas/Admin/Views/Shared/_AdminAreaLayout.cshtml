@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container admin-shell">
    <aside class="admin-sidebar">
        <h3 style="margin-top:0;">Admin Dashboard</h3>
        <a asp-area="Admin" asp-controller="Manage" asp-action="CreateCategory">إدارة الفئات</a>
        <a asp-area="Admin" asp-controller="Manage" asp-action="CreateBrand">إدارة العلامات التجارية</a>
        <a asp-area="Admin" asp-controller="Manage" asp-action="CreateProduct">إدارة المنتجات</a>
        <a asp-area="Admin" asp-controller="Manage" asp-action="Issues">إدارة الطلبات والمشاكل</a>
        <a asp-area="Admin" asp-controller="Manage" asp-action="SendNewspaper">العروض والكوبونات</a>
    </aside>

    <section>
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">إجمالي المبيعات</div><div class="stat-value">$1.24M</div></div>
            <div class="stat-card"><div class="stat-label">الطلبات اليوم</div><div class="stat-value">2,846</div></div>
            <div class="stat-card"><div class="stat-label">مستخدمون نشطون</div><div class="stat-value">18,220</div></div>
            <div class="stat-card"><div class="stat-label">معدل التحويل</div><div class="stat-value">5.9%</div></div>
        </div>
        <div class="chart-box">تقارير ورسوم بيانية تفاعلية للمبيعات، الطلبات، والأداء حسب البائعين.</div>

        <div class="detail-panel" style="margin-top:16px;">
            @RenderBody()
        </div>
    </section>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
