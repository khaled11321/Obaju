@{
    ViewData["Title"] = "Marketplace";

    var productData = new[]
    {
        new { Name = "سماعات لاسلكية ANC Pro", Price = 299, Old = 399, Reviews = 2150, Rating = 4.8, Image = "images/product1.jpg", Deal = true, Badge = "الأكثر مبيعاً" },
        new { Name = "حذاء رياضي UltraRun", Price = 189, Old = 259, Reviews = 948, Rating = 4.7, Image = "images/product2.jpg", Deal = true, Badge = "عرض خاص" },
        new { Name = "مكنسة ذكية RoboClean", Price = 499, Old = 620, Reviews = 1320, Rating = 4.6, Image = "images/product3.jpg", Deal = false, Badge = "موصى به" },
        new { Name = "ساعة ذكية Fit Pulse", Price = 249, Old = 310, Reviews = 873, Rating = 4.5, Image = "images/product1_2.jpg", Deal = false, Badge = "شحن سريع" }
    };

    var sections = new[] { "أفضل العروض اليوم", "الأكثر مبيعاً", "منتجات موصى بها", "منتجات حسب الفئة", "بناءً على اهتماماتك" };
}

<div class="container hero">
    <div id="main-slider" class="owl-carousel owl-theme" aria-label="Hero promotions">
        <div class="hero-slide">
            <div>
                <h1>منصة تجارة إلكترونية عالمية متعددة البائعين</h1>
                <p>تجربة شراء فائقة السرعة، آلاف المنتجات، شحن مرن، ومدفوعات آمنة.</p>
                <button class="btn-cta" type="button">ابدأ التسوق الآن</button>
            </div>
        </div>
        <div class="hero-slide" style="background: linear-gradient(120deg,#0f5132,#198754)">
            <div>
                <h1>عروض موسمية ضخمة حتى 60%</h1>
                <p>استفد من التخفيضات اليومية على الإلكترونيات والأزياء والمنزل.</p>
                <button class="btn-cta" type="button">اكتشف العروض</button>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="market-grid-4" style="margin-bottom:24px;">
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
    </div>

    @foreach (var section in sections)
    {
        <section style="margin-bottom:32px;">
            <div class="section-head">
                <h2>@section</h2>
                <a href="#">عرض الكل</a>
            </div>
            <div class="market-grid-4">
                @foreach (var item in productData)
                {
                    var discount = (int)Math.Round((1 - (decimal)item.Price / item.Old) * 100);
                    <article class="product-card">
                        <span class="chip">@item.Badge</span>
                        <a class="product-media" asp-controller="Product" asp-action="Details" asp-route-id="1">
                            <img src="~/@item.Image" alt="@item.Name" loading="lazy" />
                        </a>
                        <div class="product-content">
                            <h3 class="product-title">@item.Name</h3>
                            <div class="rating"><i class="fa fa-star"></i> @item.Rating <span style="color:#64748b">(@item.Reviews مراجعة)</span></div>
                            <div class="price-line">
                                <span class="price">$@item.Price</span>
                                <span class="price-old">$@item.Old</span>
                                <span class="discount">%@discount-</span>
                            </div>
                            <div class="card-actions">
                                <button class="btn-add" data-add-cart type="button">أضف للسلة</button>
                                <button class="btn-like" type="button" aria-label="Wishlist"><i class="fa fa-heart-o"></i></button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
