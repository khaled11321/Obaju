@model List<ProductListViewModel>
@{
    ViewData["Title"] = "Category";
}

<div class="container category-layout">
    <aside class="filter-box">
        <h4>فلترة متقدمة</h4>
        <div class="filter-group">
            <label>نطاق السعر</label>
            <input type="range" min="50" max="2000" value="900" class="form-control" />
        </div>
        <div class="filter-group">
            <label>التقييم</label>
            <label><input type="checkbox" /> 4 نجوم فأعلى</label>
            <label><input type="checkbox" /> 3 نجوم فأعلى</label>
        </div>
        <div class="filter-group">
            <label>العلامة التجارية</label>
            <label><input type="checkbox" /> Nike</label>
            <label><input type="checkbox" /> Adidas</label>
            <label><input type="checkbox" /> Apple</label>
        </div>
        <div class="filter-group">
            <label>خيارات الشحن</label>
            <label><input type="checkbox" /> شحن اليوم التالي</label>
            <label><input type="checkbox" /> شحن مجاني</label>
        </div>
        <div class="filter-group">
            <label>اللون / المقاس</label>
            <label><input type="checkbox" /> أسود</label>
            <label><input type="checkbox" /> أبيض</label>
            <label><input type="checkbox" /> M / L</label>
        </div>
        <div class="filter-group">
            <label><input id="onlyDeals" type="checkbox" /> العروض فقط</label>
        </div>
    </aside>

    <section>
        <div class="sort-row">
            <h1 style="margin:0;">@ViewBag.Category منتجات</h1>
            <select id="sortProducts" class="form-control" style="max-width: 260px;">
                <option value="latest">الأحدث</option>
                <option value="priceAsc">السعر من الأقل للأعلى</option>
                <option value="topRated">الأعلى تقييماً</option>
            </select>
        </div>

        <div class="market-grid-4 js-filter-container">
            @foreach (var product in Model)
            {
                var rating = 4.1 + ((product.Id % 8) * 0.1);
                var oldPrice = product.Price + 45;
                var discount = (int)Math.Round((1 - (decimal)product.Price / oldPrice) * 100);
                <article class="product-card js-filter-card" data-price="@product.Price" data-rating="@rating" data-deal="@product.OnSale.ToString().ToLowerInvariant()">
                    @if (product.OnSale) { <span class="chip">عرض خاص</span> }
                    <a class="product-media" asp-action="Details" asp-route-id="@product.Id"><img src="~/@product.FrontImage" alt="@product.Name" loading="lazy" /></a>
                    <div class="product-content">
                        <h3 class="product-title"><a asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h3>
                        <div class="rating"><i class="fa fa-star"></i> @rating.ToString("0.0") <span style="color:#64748b">(120)</span></div>
                        <div class="price-line"><span class="price">$@product.Price</span><span class="price-old">$@oldPrice</span><span class="discount">%@discount-</span></div>
                        <div class="card-actions">
                            <button class="btn-add" data-add-cart type="button">أضف للسلة</button>
                            <button class="btn-like" type="button"><i class="fa fa-heart-o"></i></button>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
</div>
