@model ProductDetailsViewModel
@{
    ViewData["Title"] = "Product Details";
}

<div class="container" style="margin-top:24px;">
    <div class="product-detail-grid">
        <div>
            @foreach (var image in Model.Images)
            {
                <div class="gallery-thumb"><img src="~/@image" alt="@Model.Name" data-photo="/@image" /></div>
            }
        </div>

        <div class="main-photo">
            <img id="mainPhoto" src="~/@Model.Images.FirstOrDefault()" alt="@Model.Name" />
        </div>

        <div class="detail-info detail-panel">
            <h1>@Model.Name</h1>
            <div class="rating"><i class="fa fa-star"></i> 4.7 <span style="color:#64748b">(1,285 مراجعة)</span></div>
            <p class="price" style="margin:8px 0;">$@Model.Price</p>
            <p style="color:#64748b;">شحن سريع خلال 24-48 ساعة • إرجاع مجاني خلال 30 يوم • ضمان البائع.</p>

            <div class="filter-group">
                <label>اللون</label>
                <div class="choices"><button class="choice active">أسود</button><button class="choice">أزرق</button><button class="choice">رمادي</button></div>
            </div>
            <div class="filter-group">
                <label>المقاس / السعة</label>
                <div class="choices"><button class="choice active">M</button><button class="choice">L</button><button class="choice">XL</button></div>
            </div>

            <div class="card-actions" style="margin-top:16px;">
                <button class="btn-add" data-add-cart type="button">إضافة إلى السلة</button>
                <button class="btn-cta" type="button">شراء الآن</button>
            </div>
        </div>
    </div>

    <div class="detail-panel" style="margin-top:20px;">
        <h3>تفاصيل المنتج</h3>
        <p>@Html.Raw(Model.Details)</p>
        <h4>سياسة الشحن والإرجاع</h4>
        <p>الشحن الدولي متاح، مع خيارات تتبع كاملة. يمكنك إرجاع المنتج خلال 30 يوم إذا كان بحالته الأصلية.</p>
        <h4>الأسئلة والأجوبة</h4>
        <p><strong>س:</strong> هل المنتج أصلي؟ <br /><strong>ج:</strong> نعم، جميع المنتجات موثقة من البائعين المعتمدين.</p>
        <h4>مراجعات العملاء</h4>
        <p>واجهة تقييم كاملة تدعم التقييم النصي والنجوم مع فلترة حسب التقييم.</p>
    </div>

    <section style="margin-top:22px;">
        <div class="section-head"><h2>منتجات مشابهة</h2><a href="#">عرض الكل</a></div>
        <div class="market-grid-4">
            @foreach (var image in Model.Images.Take(4))
            {
                <article class="product-card">
                    <a class="product-media" href="#"><img src="~/@image" alt="Similar product" /></a>
                    <div class="product-content"><h3 class="product-title">منتج مشابه</h3><div class="price-line"><span class="price">$199</span></div></div>
                </article>
            }
        </div>
    </section>
</div>
